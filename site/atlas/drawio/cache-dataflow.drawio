        <mxCell id="c201" value="&lt;b&gt;DRAM&lt;/b&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;LPDDR4X, 8 ch&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;91 ns ≈ 290 clk&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;color:#4b5563'&gt;68 GB/s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6c9c9;strokeColor=#dc2626;strokeWidth=1.4;dashed=0;fontSize=10;fontColor=#1f2937;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
