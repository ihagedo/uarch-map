        </mxCell>
        <mxCell id="c102" value="index_i = hash(PC, h[0:L_i]),  L1 &lt; L2 &lt; L3 &lt; L4 geometric;  entry: 3 bit signed ctr, 8 to 12 bit tag, 1 to 2 bit u" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="411.0" width="474.9" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c103" value="Allocate on a mispredict into a longer table whose u is 0; u set when the provider beats altpred. TAGE-SC-L (Fig. 1, 2014) adds a loop" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="467.5" width="619.0" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c104" value="predictor and a statistical corrector after the TAGE output. History is outcomes plus a short path history (27 bits in 2016)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="483.5" width="554.7" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c105" value="Nair, MICRO 1995: path based correlation. A shift register of recent branch addresses, not outcomes, indexes the counters." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
