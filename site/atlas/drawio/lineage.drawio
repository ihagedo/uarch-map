        <mxCell id="c252" value="longest history hit wins" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#4b5563;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
