        </mxCell>
        <mxCell id="c257" value="The loop predictor and retire time training are patent readings; the statistical corrector has no measurement either way." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
