        </mxCell>
        <mxCell id="c253" value="index_i = PC[18:2] XOR fold(path, L_i), split by PC bit 6 so two branches of one 128 B block read together" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="997.0" y="397.0" width="459.8" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c254" value="base predictor: not measured, drawn absent; a bimodal T0 is the TAGE default and likely (mine)" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="997.0" y="441.5" width="443.5" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c255" value="path record: on a taken or indirect branch, shift 1 and XOR in PC bits 2 to 24 and the 19 offset bits (cond) or PC 2 to 5, 25 to 30 and target 2 to 30 (indirect)" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="997.0" y="459.5" width="705.9" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c256" value="about 44 000 entries in all (derived); 13 cycle mispredict (corroborated); no privilege or ASID tag (measured)" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
