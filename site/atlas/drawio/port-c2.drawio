        <mxCell id="c3" value="Shared L2, textbook form: 12 MiB, 12 ways, 128 B lines in two halves, physically indexed and hashed" style="text;html=1;kind=title;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="1402" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Four cores share it. The index is physical and partly hashed, each line is two independent 64 B halves, and the replacement spares lines an L1 still holds." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
