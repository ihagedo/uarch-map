        <mxCell id="c96" value="12" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
