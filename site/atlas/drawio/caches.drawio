        <mxCell id="c3" value="Fig. C2  Shared L2: 12 MiB, 12 ways, 128 B lines in two halves, physically indexed and hashed" style="text;html=1;kind=primitives;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
