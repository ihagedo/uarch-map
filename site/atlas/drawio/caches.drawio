        <mxCell id="c224" value="zero tag?" style="text;html=1;whiteSpace=nowrap;fontSize=7.5;fontColor=#9ca3af;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="915.6" y="365.5" width="38.8" height="12.5" as="geometry" />
        </mxCell>
        <mxCell id="c225" value="way 4 half 0 is the line being read; the other half stays in the L2 only until it is touched (GoFetch), or both halves fill the L1 (iLeakage). Disputed." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="399.5" width="668.9" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c226" value="core id | lru: replacement is LRU among one core's lines but not across cores (S2C). Proposed: per core LRU stacks inside the set, a victim core chosen round robin or by share." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="423.5" width="809.2" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c227" value="L1 copy bits: which of the four L1Ds hold this line (duplicate L1 tags, patent). The replacement takes lines with no L1 copy first (AutoLock, measured, threshold 3 of 8 on S2C's test)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="439.5" width="831.4" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c228" value="zero tag: an all zero line held as a tag bit with no data array write (patent, unmeasured)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="455.5" width="405.9" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c229" value="Lookup order (patent, inferred): partial tag compare on a few tag bits fires the sense amplifiers of only the matching ways, then the full 20 bit compare on those. No way predictor table." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="491.5" width="843.8" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c230" value="Hit latency 17 cycles from the core (single source; 15 and 18 also quoted). My split: 4 L1 to L2 request, 9 L2 lookup and array, 4 return of two 32 B beats." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="507.5" width="700.6" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c231" value="Ordering: requests stay in order within one 128 B line but may pass across lines (patent). A core's read of half 1 can pass its own write of half 0 (Handley v3)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="531.5" width="722.5" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c232" value="Bandwidth per core: 85 GB/s load, 100 GB/s store (single source); 32 B/cycle each way on the L1 to L2 path (derived)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="555.5" width="548.6" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c233" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fff8f3;strokeColor=#dfb396;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="190.0" width="460.0" height="420.0" as="geometry" />
        </mxCell>
        <mxCell id="c234" value="Four cachelets, 2048 sets each" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#f97316;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1027.0" y="192.5" width="206.1" height="17.5" as="geometry" />
        </mxCell>
