        <mxCell id="c3" value="Fig. C3  System level cache: 8 MiB, 16 ways, 4096 sets, memory side, fully hashed" style="text;html=1;kind=primitives;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="784" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Not a CPU cache in the usual sense. It sits on the memory side of coherence, holds what the L2s evict, and is exclusive of them." style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
