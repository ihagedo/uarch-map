        </mxCell>
        <mxCell id="c383" value="PACMAN saw only 4 effective ways in an eviction test; proposed: utag aliasing hides half the ways from a VA only probe, so it undercounts." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
