        </mxCell>
        <mxCell id="c260" value="One core sees 17 cycles up to 3 MiB, more beyond, and" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="469.5" width="257.7" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c261" value="about 7.5 MiB in all (3 + 3 x 1.5). Whether the cachelets" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="485.5" width="259.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c262" value="are physical slices or a policy is open." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
