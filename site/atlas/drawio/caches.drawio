        </mxCell>
        <mxCell id="c97" value="0" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1450.2" y="255.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c98" value="state: only invalid, valid and modified; st: sticky. Only I, V, M: no shared or owned state, because nothing above it needs to be snooped" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="271.0" width="656.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c99" value="through it. Partial writes keep a byte mask; later designs track dirty per 64 B half (Handley v8)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="287.0" width="461.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c100" value="group id and sticky: driver set quotas cap each client group, and replacement skips sticky lines (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="311.0" width="504.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c101" value="Range registers can map an address range into SLC lines as memory, for camera or display frames (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="327.0" width="523.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c102" value="Replacement: pseudo random (EXAM) against LRU placed by GPU reads (SLAC). Disputed. Proposed reconciliation:" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="351.0" width="561.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c103" value="the insertion position depends on the client group, so a CPU victim and a GPU read land in different LRU" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="367.0" width="506.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c104" value="positions and a probe from one side sees a different policy from a probe on the other." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="383.0" width="411.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c105" value="Slices: two (even and odd lines, 2012 patent) or four planes (Asahi, documented). Each behind its own arbiter." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="407.0" width="532.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c106" value="Latency about 90 cycles from a core (reported, no measurement pinned). Proposed split: 17 L2 miss detect," style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="431.0" width="519.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c107" value="20 to the coherence point and tag check, 30 SLC array at a lower clock, 20 return over the fabric." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="447.0" width="470.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c108" value="Test: a pointer chase sized between 12 and 20 MiB gives the SLC latency directly once the L2 is" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="471.0" width="472.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c109" value="thrashed; nobody has published that number for the M1 with the chase confined to L2 victims." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="487.0" width="454.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c110" value="Power: ways power down to match the share in use, idle SRAM held at retention voltage, low QoS" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="519.0" width="480.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c111" value="requests batched until it wakes (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="535.0" width="198.6" height="15.0" as="geometry" />
        </mxCell>
