        </mxCell>
        <mxCell id="c138" value="issuing uop would have forced a new group (rule, inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="247.0" width="287.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c139" value="Group entry (proposed): 7 uop slots with done bits, a count of" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="271.0" width="297.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c140" value="map changing uops to pop from the history file, an exception" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="287.0" width="295.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c141" value="slot, and a branch flag; retire pops up to 8 groups a cycle." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="303.0" width="281.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c142" value="Handley reads the same knees as one failable slot per row" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="327.0" width="286.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c143" value="(a row retires only when its single memory op or branch is" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="343.0" width="286.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c144" value="done). The two readings differ on whether 2 memory ops" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="359.0" width="277.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c145" value="can share a row. Test: a stream of pairs ldr ldr nop nop nop" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="375.0" width="289.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c146" value="nop nop gives 330 x 7 under one row per memory op and" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="391.0" width="277.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c147" value="330 x 3.5 if each ldr opens its own row." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="407.0" width="198.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c148" value="Load and non speculative store queue entries are released before retire (inferred), so the LSQ" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="433.0" width="450.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c149" value="is not what holds a group open; the group waits for the done bits of its issuing uops." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
