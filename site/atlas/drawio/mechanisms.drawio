        </mxCell>
        <mxCell id="c71" value="The 18 and 50 are not 31 and 32 architectural registers, so the files do not hold one committed copy per" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="549.0" width="498.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c72" value="architectural register in the obvious way. Proposed: architectural state lives in the same pool and the" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="565.0" width="490.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c73" value="probe cannot free the registers its own loop holds live (about 18 of them). A probe with fewer live" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="581.0" width="470.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c74" value="registers in the loop would then measure closer to 362 + 18." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="597.0" width="292.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c75" value="4 banks with bank power gating, 2 to 3 cycles to wake (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="621.0" width="312.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c76" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f2faf8;strokeColor=#8abfb3;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="740.0" y="260.0" width="740.0" height="390.0" as="geometry" />
        </mxCell>
        <mxCell id="c77" value="Rename retire queue, the history file" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#059669;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="747.0" y="262.5" width="236.4" height="17.5" as="geometry" />
        </mxCell>
        <mxCell id="c78" value="623 entries, confirmed" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1353.9" y="264.5" width="119.1" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c79" value="one entry per uop that changes the map (field set inferred, widths mine)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="282.5" width="386.4" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c80" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#94c2b9;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="300.0" width="700.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c81" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#50b696;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="300.0" width="175.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c82" value="arch reg" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="826.4" y="305.5" width="42.2" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c83" value="23" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="759.0" y="325.0" width="15.7" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c84" value="18" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="922.5" y="325.0" width="13.5" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c85" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#50b696;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="935.0" y="300.0" width="262.5" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c86" value="old physical" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1035.6" y="305.5" width="61.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c87" value="17" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="934.0" y="325.0" width="13.5" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c88" value="9" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1187.7" y="325.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c89" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#50b696;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="1197.5" y="300.0" width="262.5" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c90" value="new physical" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1295.3" y="305.5" width="66.9" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c91" value="8" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1196.5" y="325.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c92" value="0" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1450.2" y="325.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c93" value="Allocated at rename, 8 per cycle. Retired 16 per cycle (corroborated), freeing the old physical register." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="341.0" width="490.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c94" value="Not every uop takes one: NOP, B, stores and compares with no destination do not, which is why the NOP" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="357.0" width="509.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c95" value="window (2277) and the register writing window (623) differ." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="373.0" width="293.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c96" value="Mispredict recovery (inferred): walk from the tail back to the branch, restoring old physical into the map" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="399.0" width="501.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c97" value="and returning new physical to the free list. With 16 per cycle the worst walk is 39 cycles; most are short." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="415.0" width="509.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c98" value="Proposed detail: each branch records the queue tail at rename (10 bits), and recovery walks only to that" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="439.0" width="498.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c99" value="mark. The 144 branch limit would then be the size of a branch checkpoint table, not a counter." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="455.0" width="455.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c100" value="Test: a mispredict with many register writes after the branch should cost more than one with few; the" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="471.0" width="494.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c101" value="slope gives the walk rate. A checkpointed design would show a flat cost." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="487.0" width="358.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c102" value="Flags are renamed in a separate 128 entry file per domain (measured); flag moves are handled in the map" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="515.0" width="508.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c103" value="rather than issued (patent); other special register writes go to speculative storage (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="531.0" width="436.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c104" value="Why the retire rate is 16 and the rename rate 8 (proposed): the queue is two banked halves, each" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="555.0" width="465.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c105" value="retiring 8 a cycle, so retire can catch up after a stall without ever becoming the limit." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="571.0" width="413.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c106" value="Window arithmetic: 623 / 8 per cycle = 78 cycles of register writing work in flight, enough to cover" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="595.0" width="482.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c107" value="an L2 miss to the SLC (about 90 cycles) only with some non writing uops mixed in." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="611.0" width="410.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c108" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f2faf8;strokeColor=#8abfb3;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20.0" y="675.0" width="1460.0" height="165.0" as="geometry" />
        </mxCell>
        <mxCell id="c109" value="Dispatch after rename" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#059669;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="27.0" y="677.5" width="144.6" height="17.5" as="geometry" />
        </mxCell>
        <mxCell id="c110" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5fbf9;strokeColor=#50b696;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="35.0" y="705.0" width="460.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="c111" value="Unordered dispatch buffers (inferred)" style="text;html=1;whiteSpace=nowrap;fontSize=12;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="707.0" width="225.6" height="17.0" as="geometry" />
