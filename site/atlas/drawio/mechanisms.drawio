        <mxCell id="c96" value="ctr3 | tag | u | way" style="text;html=1;whiteSpace=nowrap;fontSize=8.5;fontColor=#4b5563;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="859.3" y="476.5" width="81.5" height="13.5" as="geometry" />
        </mxCell>
        <mxCell id="c97" value="index = PC[18:2]  XOR  fold(history, L_i)      split by PC bit 6: the two halves of a 128 B block are read together, two branches per lookup (measured)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="534.0" width="715.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c98" value="each table has its own associativity (measured) and 3 bit counters (corroborated); about 44 000 entries in all (derived)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="551.0" width="570.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c99" value="base predictor: not measured. Likely a bimodal table indexed by PC alone, the TAGE default." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="567.0" width="452.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c100" value="Provider: longest history table whose tag matches; altpred: next longest. Allocate on a mispredict into one or two longer tables (cold start writes four, patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="592.0" width="762.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c101" value="Training at retire from branch information tables carried from decode, only on mispredicts and weak counters (patent). Loop predictor beside it (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="608.0" width="728.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c102" value="No privilege or process tag on these entries (measured): two processes that collide in index and tag share a counter." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="634.0" width="561.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c103" value="Mispredict penalty 13 cycles (corroborated). 100 branches of history ≈ one history bit per 1.1 taken branches over the window of 144 in flight." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="650.0" width="670.8" height="15.0" as="geometry" />
        </mxCell>
