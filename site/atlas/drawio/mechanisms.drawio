        <mxCell id="c126" value="" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#fcf6fd;strokeColor=#c026d3;strokeWidth=0.9;dashed=1;dashPattern=2 2;" vertex="1" parent="1">
