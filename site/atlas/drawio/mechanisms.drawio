        </mxCell>
        <mxCell id="c92" value="meets a strong set goes to a FIFO overflow table (patent)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="517.0" width="280.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c93" value="Phantom fetch: a non branch at a trained PC redirects fetch, so the tag does not cover the full PC and" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
