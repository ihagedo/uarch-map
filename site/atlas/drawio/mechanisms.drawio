          <mxGeometry x="20.0" y="70.0" width="1460.0" height="165.0" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Example group of 8, as decode delivers it" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#0891b2;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
