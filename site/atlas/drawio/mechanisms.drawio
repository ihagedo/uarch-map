        </mxCell>
        <mxCell id="c160" value="indirect branches fold in target bits 2 to 30 (measured), so the history encodes where the last calls went" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
