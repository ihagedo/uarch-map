        </mxCell>
        <mxCell id="c25" value="set index 13:6 lies inside the page offset, so the lookup starts before translation (measured). bank = bits 7:4 for 16 banks of 16 B (derived). utag: 8 bit micro tag from VA 47:14 picks the way, as AMD does (measured, PACMAN style probe)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="149.0" width="1141.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="Note the overlap: bits 7:6 are in both the set and the bank field, so the 16 banks span 4 lines of a set; two loads to the same bank in one cycle collide unless they piggyback on the same element (inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
