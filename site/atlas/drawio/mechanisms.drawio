        </mxCell>
        <mxCell id="c6" value="Path history register, 100 bits" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
