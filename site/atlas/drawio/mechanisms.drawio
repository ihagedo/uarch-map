        <mxCell id="c100" value="P" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="254.8" y="469.5" width="12.4" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c101" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="274.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c102" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c103" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="326.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c104" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="352.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c105" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="378.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c106" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="404.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c107" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="430.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c108" value="A accessed, P prefetched; a stride 2 pattern in the map is matched and extended (region size unknown, 4 KiB in the AMPM paper)" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="494.5" width="597.6" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c109" value="map granularity grows from 64 B to 128 B to 256 B for long patterns (measured, Handley v2). 16 stride streams at once (measured)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="510.5" width="599.6" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c110" value="Side tables: large stride, and spatial memory streaming for dense regions (inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="526.5" width="386.2" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c111" value="Temporal history (inferred): a GHB like buffer of just under 256 entries covers random access inside a 15 KiB region, not 16 KiB." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="550.5" width="585.8" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c112" value="Proposed: the 15 KiB bound is the 256 entry buffer minus a few entries the probe loop itself consumes; 15 KiB / 64 B = 240 lines." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="566.5" width="594.8" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c113" value="Data memory dependent prefetcher (measured, Augury and GoFetch)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="443.5" width="367.1" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c114" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fcf4dc;strokeColor=#f0ca52;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="760.0" y="465.0" width="700.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="c115" value="Pointer chasing rule" style="text;html=1;whiteSpace=nowrap;fontSize=12;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="467.0" width="127.4" height="17.0" as="geometry" />
        </mxCell>
        <mxCell id="c116" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=1;strokeColor=#d7cca6;dashed=0;endArrow=none;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="766.0" y="486.0" as="sourcePoint" />
            <mxPoint x="1454.0" y="486.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c117" value="○" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="490.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c118" value="scans filled lines for 8 B values that look like pointers into the same 4 GiB region" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="776.0" y="489.0" width="416.8" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c119" value="○" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="504.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c120" value="arms after 3 accesses with a stride up to 8 KiB, reaches 64 KiB past the trained array" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="776.0" y="503.5" width="437.1" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c121" value="○" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="519.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c122" value="one dereference level; prefetches the pointed to line into the L2, not the L1" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="776.0" y="518.0" width="379.5" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c123" value="○" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="765.0" y="533.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c124" value="a 128 entry history filter stops repeats (derived); off only via a privileged HID11 bit" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="776.0" y="532.5" width="412.4" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c125" value="Throttle (patent): every 32 cycles the L2 rates each core's prefetch queue and sets a level; credits cap a region near" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="599.5" width="533.0" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c126" value="4 prefetches in flight; prefetch grows bolder when misses return late. Deny list for lines evicted unused (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="615.5" width="516.2" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c127" value="Non temporal loads are not prefetched into the L1 (inferred). Streaming stores become non temporal on their own (inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="639.5" width="561.5" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c128" value="Which level each prefetcher fills (inferred): stride and region into the L1D through the fill buffers (hence the stolen bank cycles); DMP and temporal into the L2 only." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="679.0" width="787.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c129" value="Proposed test for the fill buffer share: a stride stream that keeps 16 lines in flight plus a pointer chase. If the chase slows, demand and prefetch share one pool." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="703.0" width="767.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c130" value="Beyond the L2: Little's law again gives about 48 L2 lines of 128 B in flight to draw 64 GB/s from DRAM at 97 ns (KB), which is the L2 miss queue depth to look for." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="727.0" width="799.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c131" value="DRAM fills enter the L2 as well as the L1 (inclusive, settled); the SLC takes only L2 victims (settled), so a streaming read through 12 MiB writes the SLC at the L2 eviction rate." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="751.0" width="857.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c132" value="Consequence (mine): with the SLC exclusive, one core sweeping a buffer up to about 20 MiB (12 L2 + 8 SLC) still hits on chip; past that, both thrash together and latency jumps to DRAM." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="775.0" width="901.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c133" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f7e4a6;strokeColor=#eab308;strokeWidth=2.2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="886.0" width="16.0" height="11.0" as="geometry" />
        </mxCell>
        <mxCell id="c134" value="● confirmed, 3+ measurements" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
