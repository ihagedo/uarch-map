        </mxCell>
        <mxCell id="c127" value="f9" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1429.8" y="317.0" width="14.4" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c128" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=1.2;strokeColor=#c026d3;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1269.0" y="350.0" as="sourcePoint" />
            <mxPoint x="1269.0" y="338.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c129" value="head" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#c026d3;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1255.9" y="352.0" width="26.2" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c130" value="Each branch in flight stores only the head index (7 bits for 144)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="379.0" width="305.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c131" value="instead of a 100 bit copy. On a mispredict the head rewinds to" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="395.0" width="301.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c132" value="that mark and the corrected footprint is pushed; the history" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="411.0" width="284.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c133" value="register is rebuilt by re folding the footprints after the mark." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="427.0" width="288.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c134" value="Alternative: full copies of both history registers per branch." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="451.0" width="287.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c135" value="No timing probe tells them apart (KB)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="467.0" width="187.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c136" value="Test I would add: a probe that mispredicts once per N taken" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="493.0" width="292.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c137" value="branches for N from 1 to 150. Rebuild cost grows with the" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="509.0" width="278.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c138" value="number of footprints after the mark under the rewind design" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="525.0" width="288.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c139" value="and is flat under the copy design." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="541.0" width="164.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c140" value="Also measured: wrong path indirect branches are squashed as" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="569.0" width="302.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c141" value="soon as their target computes, and fetch moves to that target," style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="585.0" width="299.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c142" value="so recovery is not serialised on the oldest mispredict." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1032.0" y="601.0" width="263.5" height="15.0" as="geometry" />
