        <mxCell id="c3" value="Fig. M7  A miss through the fill buffers, the L2 and the prefetchers" style="text;html=1;kind=primitives;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="618" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="The number of outstanding misses is a hole. The KB bounds it by Little's law; the fill buffer pool is the KB conjecture; the L2 indexing is measured." style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
