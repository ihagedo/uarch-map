        <mxCell id="c90" value="pred mask: which slow predictors this group needs, the rest clock gated (patent)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
