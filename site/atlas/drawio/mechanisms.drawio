        <mxCell id="c112" value="reads the source register at issue" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="401.0" y="584.0" width="172.9" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c113" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="390.0" y="599.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c114" value="writes 16 B data lanes into the slot" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="401.0" y="598.5" width="180.7" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c115" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="390.0" y="614.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c116" value="a slot gathers stores within 32 B (inferred)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="401.0" y="613.0" width="218.7" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c117" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="390.0" y="628.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c118" value="a line crossing store takes two slots" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="401.0" y="627.5" width="189.5" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c119" value="Commit after retire: the oldest slot writes to the L1D over 16 B paths, 2 per cycle, 32 B/cycle (corroborated)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="684.0" width="523.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c120" value="Store miss: write allocate with a store miss entry that fetches the line for ownership while younger store hits write ahead (KB, ours)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="700.0" width="644.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c121" value="Full line streaming stores skip the fetch and go non temporal with no hint (inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="716.0" width="407.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c122" value="Store queue 60 entries, 2 banks (KB conjecture): one bank fills with a contiguous run while the other drains." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="740.0" width="523.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c123" value="Why 2 banks (mine): one write port per bank gives 2 stores per cycle into the queue and 2 commits per cycle out of it with single ported SRAM." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="756.0" width="694.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c124" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fefbf3;strokeColor=#dac991;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="770.0" y="530.0" width="710.0" height="270.0" as="geometry" />
        </mxCell>
        <mxCell id="c125" value="Memory dependence" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#eab308;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="777.0" y="532.5" width="135.8" height="17.5" as="geometry" />
        </mxCell>
        <mxCell id="c126" value="dependence predictor entry, 74 entries, round robin replacement (inferred)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="547.5" width="394.5" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c127" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#d8cb9c;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="790.0" y="565.0" width="670.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c128" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="790.0" y="565.0" width="335.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c129" value="store PC hash" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="922.8" y="570.5" width="69.4" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c130" value="23" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="789.0" y="590.0" width="15.7" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c131" value="12" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1112.5" y="590.0" width="13.5" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c132" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="1125.0" y="565.0" width="335.0" height="24.0" as="geometry" />
        </mxCell>
        <mxCell id="c133" value="load PC hash" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1259.4" y="570.5" width="66.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c134" value="11" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1124.0" y="590.0" width="11.3" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c135" value="0" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1450.2" y="590.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c136" value="A load whose PC matches an entry waits for the matching older store; any other load is predicted free and" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="604.0" width="513.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c137" value="issues past unresolved stores. A wrong guess costs a 25 cycle ordering flush (measured)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="620.0" width="436.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c138" value="No load value prediction and no load address prediction on the M1 (corroborated; both appear on later cores)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="644.0" width="520.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c139" value="Zero cycle load (likely, narrow): a load that uses the store's address register with an immediate offset is" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="668.0" width="508.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c140" value="renamed to the stored value's register, 5 cycles instead of 7 in Handley's probe." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="684.0" width="388.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c141" value="Proposed mechanism for the narrow case: the map keeps, per architectural base register, the last store's" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="708.0" width="507.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c142" value="offset and data register; a load with the same base and offset is mapped to that register at rename and" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="724.0" width="495.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c143" value="verified by the LSU afterwards. That explains why only the same register and immediate case speeds up." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="740.0" width="513.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c144" value="Test: store [x1, #8] then load [x2, #8] with x2 = x1 copied by an eliminated move. If the match is by" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="764.0" width="480.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c145" value="physical register the load speeds up; if by architectural name it does not." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="780.0" width="355.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c146" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefbf3;strokeColor=#dac991;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20.0" y="825.0" width="1460.0" height="85.0" as="geometry" />
        </mxCell>
        <mxCell id="c147" value="Splits and crossings (measured)" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#eab308;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="27.0" y="827.5" width="209.9" height="17.5" as="geometry" />
        </mxCell>
        <mxCell id="c148" value="unaligned or line crossing: one uop, two line requests, about 1 cycle more.   page crossing: 28 to 31 cycles more, read as a microcode assist.   LDP of Q registers: one uop, two 16 B requests at cache access." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="844.0" width="999.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c149" value="exclusive monitor: one reservation per core, 64 B granule, cleared when the line leaves the L1D.   TSO mode: a control bit gives x86 ordering for Rosetta, loads still out of order." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="32.0" y="862.0" width="851.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c150" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f7e4a6;strokeColor=#eab308;strokeWidth=2.2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="931.0" width="16.0" height="11.0" as="geometry" />
        </mxCell>
        <mxCell id="c151" value="● confirmed, 3+ measurements" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
