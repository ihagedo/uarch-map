        <mxCell id="c21" value="0" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1450.2" y="134.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="conditional taken: XOR in PC bits 2 to 24 and all 19 offset bits" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="148.5" width="318.3" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="indirect: XOR in PC bits 2 to 5 and 25 to 30, and target bits 2 to 30" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="164.5" width="342.8" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="not taken conditional: no shift, no XOR (so a long run of not taken branches leaves the history still)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="180.5" width="501.5" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="Consequence: two paths that differ only in a not taken branch share a history; the PC index tells them apart only inside one table block. Measured, single source." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=2;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="204.0" width="777.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="Mapping of which history bit each PC bit lands in is folded and not published; the simulator can carry any" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="757.0" y="149.0" width="511.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="invertible fold. My default: PC bit k lands at history bit (k - 2) mod 32 so one branch touches 23 bits." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
