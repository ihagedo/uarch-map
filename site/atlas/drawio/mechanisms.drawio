          <mxGeometry x="1020.0" y="265.0" width="460.0" height="420.0" as="geometry" />
        </mxCell>
        <mxCell id="c105" value="Recovery after a mispredict" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#2563eb;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
