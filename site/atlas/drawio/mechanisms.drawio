        <mxCell id="c112" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=1;strokeColor=#9ec5be;dashed=0;endArrow=none;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="41.0" y="726.0" as="sourcePoint" />
            <mxPoint x="489.0" y="726.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c113" value="◆" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="730.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c114" value="int 2 x 24, mul 12, load/store 10, fp 12" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="51.0" y="729.0" width="195.4" height="15.5" as="geometry" />
