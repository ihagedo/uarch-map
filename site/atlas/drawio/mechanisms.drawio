        <mxCell id="c29" value="str x3,[x6]" style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;fontFamily=JetBrains Mono;connectable=0;" vertex="1" parent="1">
