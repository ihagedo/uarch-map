        <mxCell id="c63" value="7" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1329.4" y="132.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c64" value="" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1339.2" y="105.0" width="17.2" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="c65" value="half" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1336.4" y="111.5" width="23.0" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c66" value="6" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1338.2" y="132.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c67" value="6" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1346.7" y="132.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c68" value="" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#feebde;strokeColor=#fb9d5c;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1356.5" y="105.0" width="103.5" height="26.0" as="geometry" />
        </mxCell>
        <mxCell id="c69" value="byte" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1395.7" y="111.5" width="25.2" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c70" value="5" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1355.5" y="132.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c71" value="0" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1450.2" y="132.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c72" value="Set bits span the 16 KiB page offset (13:7) and the page frame (19:14), so the index needs the physical" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="149.0" width="489.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c73" value="address; two of the bits are XORed with higher frame bits (hashed), which is why some strides crowd a fraction of the cache." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="165.0" width="608.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c74" value="Each 128 B line is two 64 B halves that fill and evict on their own (measured); one study sees only the touched half" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="189.0" width="559.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c75" value="go to the L1, another sees both. Ordering at the L2 is per 128 B line (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="205.0" width="367.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c76" value="Replacement: LRU among one core's lines; across cores not LRU (measured). The L2 is inclusive of the L1Ds and its" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="229.0" width="569.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c77" value="victim choice spares lines an L1D still holds (AutoLock, measured). A partial tag way filter limits which ways are read (inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="245.0" width="626.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c78" value="Four 3 MiB cachelets, one beside each core (likely in effect): one core sees 17 cycles to 3 MiB, more beyond, and" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="269.0" width="551.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c79" value="about 7.5 MiB in all. Proposed: the two hashed index bits choose the cachelet, and a line placed by core k" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="285.0" width="516.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c80" value="in another core's cachelet pays the fabric hop, which is the latency step at 3 MiB." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="301.0" width="398.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c81" value="Arbitration (KB conjecture): per core request queues feed each L2 bank round robin, demand before prefetch." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="325.0" width="520.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c82" value="Test (KB): three cores streaming through the L2 and a fourth pointer chasing; its latency stays flat under round robin." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="341.0" width="562.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c83" value="L1 to L2 path 32 B/cycle each way (derived); copies cap near 150 GB/s on L1 to L2 coherence work (inferred)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="767.0" y="365.0" width="533.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c84" value="" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#fefbf3;strokeColor=#dac991;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="20.0" y="425.0" width="1460.0" height="410.0" as="geometry" />
        </mxCell>
        <mxCell id="c85" value="Prefetchers, trained on virtual addresses in the LSU" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#eab308;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="27.0" y="427.5" width="334.0" height="17.5" as="geometry" />
        </mxCell>
        <mxCell id="c86" value="Access map, one per region (AMPM like, inferred)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="443.5" width="271.8" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c87" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#f8e5ab;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="465.0" width="26.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c88" value="A" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="46.8" y="469.5" width="12.4" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c89" value="" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#dfc267;strokeWidth=0.8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="465.0" width="26.0" height="22.0" as="geometry" />
