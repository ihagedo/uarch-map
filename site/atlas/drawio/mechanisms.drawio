        <mxCell id="c157" value="What the indirect history gets that the conditional one does not" style="text;html=1;whiteSpace=nowrap;fontSize=12;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
