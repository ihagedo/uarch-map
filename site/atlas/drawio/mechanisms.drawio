        <mxCell id="c4" value="16 KiB pages, 48 bit virtual addresses. The set index bits are measured; the walk levels follow from the ARM 16 KiB granule." style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
