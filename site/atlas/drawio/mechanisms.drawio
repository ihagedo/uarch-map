        <mxCell id="c115" value="○" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="744.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c116" value="8 uops in per cycle (measured)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="51.0" y="743.5" width="160.6" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c117" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="759.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c118" value="1 uop per cycle out into each scheduler queue (inferred)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="51.0" y="758.0" width="281.0" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c119" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="40.0" y="773.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c120" value="rename stalls when the target buffer is full" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="51.0" y="772.5" width="220.0" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c121" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fbf2fc;strokeColor=#c026d3;strokeWidth=1.2;dashed=1;dashPattern=6 2;" vertex="1" parent="1">
          <mxGeometry x="515.0" y="705.0" width="950.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="c122" value="Steering (proposed)" style="text;html=1;whiteSpace=nowrap;fontSize=12;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="707.0" width="123.2" height="17.0" as="geometry" />
        </mxCell>
        <mxCell id="c123" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=1;strokeColor=#9ec5be;dashed=0;endArrow=none;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="521.0" y="726.0" as="sourcePoint" />
            <mxPoint x="1459.0" y="726.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c124" value="+" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="730.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c125" value="a uop picks the queue with the most free entries among the units that can run it, ties by lowest number" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="531.0" y="729.0" width="523.8" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c126" value="+" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="744.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c127" value="alternative: round robin over the eligible queues, which Johnson's unit numbering would also fit" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="531.0" y="743.5" width="488.7" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c128" value="+" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="759.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c129" value="test: a stream of one op class with a side channel of unit specific ops (mul on 5 and 6, div on 5) shows which queue fills first" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="531.0" y="758.0" width="641.3" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c130" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#a5d9c9;strokeColor=#059669;strokeWidth=2.2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="30.0" y="866.0" width="16.0" height="11.0" as="geometry" />
        </mxCell>
        <mxCell id="c131" value="● confirmed, 3+ measurements" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="47.0" y="864.5" width="146.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c132" value="" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#c0e5da;strokeColor=#059669;strokeWidth=1.4;dashed=0;" vertex="1" parent="1">
