          <mxGeometry x="40.0" y="100.0" width="165.0" height="40.0" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="ldr x1,[x2]" style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;fontFamily=JetBrains Mono;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="81.5" y="106.0" width="81.0" height="16.0" as="geometry" />
        </mxCell>
