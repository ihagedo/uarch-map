        </mxCell>
        <mxCell id="c30" value="STA + STD uops" style="text;html=1;whiteSpace=nowrap;fontSize=9;fontColor=#4b5563;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1328.8" y="123.0" width="78.4" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="Map stage (inferred): an 8 x 8 compare of destinations against sources inside the group, so slot 2 reads x1 from slot 1 without waiting a cycle, and slot 3 (mov x4,x3) is" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="154.0" width="808.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="resolved to the same physical register slot 2 will write, which is how a chain of eliminated moves completes in one cycle. Fusion merges slots 5 and 6 into one branch uop with a flag write." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="170.0" width="921.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="Measured limits: 2 immediate moves per 8 instructions eliminated (8 per 8 disputed); compare branch fusion reads at most 4 registers per 6 instructions; adrp+add and mov+movk do not fuse." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="194.0" width="920.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="Proposed cause of the 4 per 6 limit: the fused uop keeps both source reads, and the map has a read port budget of 16 per group (8 uops x 2); fusion beyond 4 would need more ports." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
