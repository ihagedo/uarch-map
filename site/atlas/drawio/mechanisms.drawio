        <mxCell id="c137" value="Group 1 holds 4 issuing uops (ldr add sub b.eq); a fifth" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
