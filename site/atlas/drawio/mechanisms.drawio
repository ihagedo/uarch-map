        <mxCell id="c476" value="shadow window, dependents keep entries" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#1f2937;fontStyle=0;align=center;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
