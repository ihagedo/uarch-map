        <mxCell id="c134" value="miss penalty 25 cycles including the walk start (corroborated)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="419.0" width="302.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c135" value="Cluster shared L2 TLB and walkers beside the L2 (patent):" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="443.0" width="288.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c136" value="if so the 25 cycles include a trip over the L1 to L2 path," style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="459.0" width="271.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c137" value="and a second core's misses contend for it." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="475.0" width="208.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c138" value="Test (mine): two cores each thrashing their L1 dTLB but" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="499.0" width="274.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c139" value="hitting the L2 TLB. Per core cost rises if the L2 TLB is" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="515.0" width="272.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c140" value="shared and single ported, stays flat if private." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="531.0" width="222.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c141" value="Only 16 KiB pages observed on the M1 (single source)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="522.0" y="551.0" width="263.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c142" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fefbf3;strokeColor=#dac991;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1000.0" y="245.0" width="480.0" height="330.0" as="geometry" />
        </mxCell>
        <mxCell id="c143" value="Page walk" style="text;html=1;whiteSpace=nowrap;fontSize=12.5;fontColor=#eab308;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1007.0" y="247.5" width="73.5" height="17.5" as="geometry" />
        </mxCell>
        <mxCell id="c144" value="inferred" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1429.4" y="249.5" width="43.6" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c145" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fefcf5;strokeColor=#f0ca52;strokeWidth=1;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="1015.0" y="275.0" width="450.0" height="100.0" as="geometry" />
        </mxCell>
        <mxCell id="c146" value="MMU walk cache" style="text;html=1;whiteSpace=nowrap;fontSize=12;fontColor=#1f2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="277.0" width="112.6" height="17.0" as="geometry" />
        </mxCell>
        <mxCell id="c147" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;strokeWidth=1;strokeColor=#d7cca6;dashed=0;endArrow=none;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1021.0" y="296.0" as="sourcePoint" />
            <mxPoint x="1459.0" y="296.0" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c148" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="300.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c149" value="caches the upper two levels (L1, L2 tables)" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1031.0" y="299.0" width="223.5" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c150" value="~" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="314.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c151" value="leaf entries read from the L2 cache" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1031.0" y="313.5" width="182.0" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c152" value="+" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="329.0" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c153" value="walk = 1 walk cache hit + 1 L2 access, about 17 + a few cycles" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1031.0" y="328.0" width="322.7" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c154" value="+" style="text;html=1;whiteSpace=nowrap;fontSize=9.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1020.0" y="343.5" width="11.3" height="14.5" as="geometry" />
        </mxCell>
        <mxCell id="c155" value="so a 25 cycle L2 TLB miss leaves 8 for TLB and walker logic" style="text;html=1;whiteSpace=nowrap;fontSize=10.5;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1031.0" y="342.5" width="320.9" height="15.5" as="geometry" />
        </mxCell>
        <mxCell id="c156" value="Permissions by index (patent): a page holds an index into a" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="389.0" width="289.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c157" value="4 entry permission table, so one core can switch a page's" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="405.0" width="283.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c158" value="permissions with no TLB shootdown." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="421.0" width="186.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c159" value="Invalidation (patent): range invalidate picks scanning or" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="445.0" width="271.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c160" value="per page lookup; ASID and VMID compared four at a time." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="461.0" width="282.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c161" value="Speculative faults: a load through a pointer that failed its" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="485.0" width="278.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c162" value="AUT check is not performed and leaves no TLB trace (measured)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="501.0" width="319.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c163" value="iTLB: 192 entries (measured) against a 4 way 32 set shape" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="525.0" width="289.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c164" value="that gives 128; shape and size do not fit, open." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1012.0" y="541.0" width="228.4" height="15.0" as="geometry" />
