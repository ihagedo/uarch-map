        <mxCell id="c16" value="Little's law from the measured L2 bandwidth: 85 GB/s at 3.2 GHz is" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="299.0" width="337.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="26.6 B/cycle; at 17 cycles that is 452 B in flight, 7.1 lines. So at" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="315.0" width="315.5" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="least 7 buffers (KB). A pointer chase into the L2 needs only one." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="331.0" width="313.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="A second miss to a line in flight joins the entry; a load that finds no" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="351.0" width="329.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="free buffer replays (KB). My guess at the count: 16, since 3 loads a" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="367.0" width="324.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="cycle and prefetch make 7 too tight." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
