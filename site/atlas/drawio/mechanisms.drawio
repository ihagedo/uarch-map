        <mxCell id="c4" value="What is measured is the history update rule and the table layout. The provider logic is standard TAGE; the recovery mechanism is the KB conjecture." style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17.0" y="36.0" width="789.9" height="16.0" as="geometry" />
