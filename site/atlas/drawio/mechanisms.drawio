        <mxCell id="c3" value="Fig. M3  An 8 wide group through map and rename" style="text;html=1;kind=primitives;fontSize=18;fontStyle=1;fontColor=#1f2937;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="17" y="11" width="474" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="A group of eight uops in one cycle. Map resolves dependences inside the group; rename hands out physical registers; the history file remembers what to undo." style="text;html=1;whiteSpace=nowrap;fontSize=11;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
