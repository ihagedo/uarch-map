        <mxCell id="c109" value="1" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1431.1" y="412.0" width="8.7" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c110" value="0" style="text;html=1;whiteSpace=nowrap;fontSize=8;fontColor=#9ca3af;fontStyle=0;align=right;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="1450.2" y="412.0" width="10.8" height="13.0" as="geometry" />
        </mxCell>
        <mxCell id="c111" value="512 sets x 2 ways = 1024 entries: PC[10:2] picks a set per instruction slot in a 2 KiB window, the two ways cover a 4 KiB footprint (measured)" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="429.0" width="688.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c112" value="Within 4 KiB a taken branch costs nothing; past it the second tier adds two bubbles, read as the L1 BTB" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="445.0" width="502.3" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c113" value="being coupled to the L1I: about 8192 entries, one per 8 B of the 192 KiB I-cache would be 24576, so" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="461.0" width="482.1" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c114" value="the 8192 looks like one target slot per 24 B, or a tagged side table. Open." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="477.0" width="354.4" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c115" value="My reading: the L0 BTB is the fetch group table itself, one structure, with the 2 way sets" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="505.0" width="432.6" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c116" value="indexed by PC[10:2] so branches 2 KiB apart share a set; a probe with three taken branches" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="521.0" width="442.0" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c117" value="exactly 2 KiB apart would show the third evicting one of the first two." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="537.0" width="340.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c118" value="1 taken branch per cycle in all cases; no trace cache on the M1 (ocxtal measured, Handley places it on M4)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#1f2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="787.0" y="561.0" width="518.7" height="15.0" as="geometry" />
        </mxCell>
