        </mxCell>
        <mxCell id="c477" value="The consumer is woken for cycle 3 on the assumption the load hits and its address check passes. A store" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782.0" y="523.0" width="513.7" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c478" value="address resolving two to four cycles late causes a replay, not a flush (measured), which is the shadow at work." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782.0" y="539.0" width="541.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c479" value="The replaying load waits in a load execution queue bank of its pipe (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782.0" y="555.0" width="370.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c480" value="Test for the shadow depth: a dependent chain of k ALU ops behind a load that replays once. Cost grows" style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782.0" y="581.0" width="502.9" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c481" value="with k until k exceeds the shadow depth, then the extra ops were never issued and cost nothing more." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#c026d3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="782.0" y="597.0" width="494.8" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c482" value="One possibly mispredicting op issues per cycle; age bits built from short per entry offsets say which younger work to flush (patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
