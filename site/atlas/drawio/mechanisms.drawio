        <mxCell id="c45" value="rA, rB: ready bits set by wakeup. shadow: 3 bit timer counting down from a load this uop was woken by; while non zero the entry stays allocated after issue so it can reissue (proposed, from the patent)." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="149.0" width="974.2" height="15.0" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="Operands are read from the register file at issue, not kept in the queue (Handley, measured), which keeps entries small and lets the file be banked." style="text;html=1;whiteSpace=nowrap;fontSize=10;fontColor=#4b5563;fontStyle=0;align=left;verticalAlign=middle;spacing=0;spacingLeft=3;spacingRight=3;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="37.0" y="165.0" width="707.8" height="15.0" as="geometry" />
        </mxCell>
