        </mxCell>
        <mxCell id="c4" value="Two CPU clusters share one memory side through the fabric. Arrow weight is traffic; dashed is control. Bandwidths are what one core measures." style="text;html=1;kind=title;fontSize=11;fontColor=#4b5563;align=left;verticalAlign=middle;connectable=0;" vertex="1" parent="1">
